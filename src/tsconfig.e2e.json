// End-to-end tests (Playwright). Run in Node, but some callbacks run in the browser,
// so DOM types are included too.
{
  "extends": "./tsconfig.node.json",
  "include": ["e2e/**/*"],
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
