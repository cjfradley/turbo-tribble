# Copy to .env.local and fill in. Values are compiled into the bundle (not secret).
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_STORAGE_URL=https://stdoclibstaging.blob.core.windows.net
VITE_CONTAINER=documents
VITE_APP_URL=http://localhost:5173
VITE_ADMIN_ROLE=DocLibrary.Admin
# Upload limits (FR-3.6). Max size in MB (default 100); allowed types like an
# <input accept> list, e.g. .pdf,.docx,image/* (empty allows all).
VITE_MAX_FILE_MB=100
VITE_ALLOWED_TYPES=
